NODE_ENV=development
SELF_HOSTED=false
RELAX_REGISTRATION_RATE_LIMITS=true
DISABLE_RATE_LIMITS=true
ASTRAL_TEST_MODE=true
ASTRAL_TEST_TOKEN=<generate-a-random-token>

ASTRAL_API_PUBLIC_ENDPOINT=http://localhost:8088/api
ASTRAL_APP_ENDPOINT=http://localhost:8088
ASTRAL_GATEWAY_ENDPOINT=ws://gateway:8080
ASTRAL_MEDIA_ENDPOINT=http://media-proxy:8080
ASTRAL_CDN_ENDPOINT=http://minio:9000/Astral-cdn
ASTRAL_MARKETING_ENDPOINT=http://marketing.astral.local
ASTRAL_ADMIN_ENDPOINT=http://admin.astral.local
ASTRAL_PATH_MARKETING=/
ASTRAL_PATH_ADMIN=/
ASTRAL_INVITE_ENDPOINT=http://invites.astral.local
ASTRAL_GIFT_ENDPOINT=http://gifts.astral.local

ASTRAL_API_PORT=8080
ASTRAL_GATEWAY_WS_PORT=8080
ASTRAL_GATEWAY_RPC_PORT=8081
ASTRAL_MEDIA_PROXY_PORT=8080
ASTRAL_ADMIN_PORT=8080
ASTRAL_MARKETING_PORT=8080
ASTRAL_GEOIP_PORT=8080

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/Astral
REDIS_URL=redis://valkey:6379

CASSANDRA_HOSTS=cassandra
CASSANDRA_KEYSPACE=astral
CASSANDRA_LOCAL_DC=datacenter1
CASSANDRA_USERNAME=cassandra
CASSANDRA_PASSWORD=<set-me>

ASTRAL_GATEWAY_RPC_HOST=gateway
ASTRAL_GATEWAY_RPC_PORT=8081
GATEWAY_RPC_SECRET=<generate-a-random-secret>
SUDO_MODE_SECRET=<generate-a-random-secret>

ASTRAL_MEDIA_PROXY_HOST=media-proxy
MEDIA_PROXY_ENDPOINT=http://media-proxy:8080
MEDIA_PROXY_SECRET_KEY=<generate-a-random-secret>

AWS_ACCESS_KEY_ID=<set-me>
AWS_SECRET_ACCESS_KEY=<set-me>
AWS_S3_ENDPOINT=http://minio:9000
AWS_S3_BUCKET_CDN=Astral-cdn
AWS_S3_BUCKET_UPLOADS=Astral-uploads
AWS_S3_BUCKET_REPORTS=Astral-reports
AWS_S3_BUCKET_HARVESTS=Astral-harvests
AWS_S3_BUCKET_DOWNLOADS=Astral-downloads

PASSKEYS_ENABLED=true
PASSKEY_RP_NAME=Astral Integration
PASSKEY_RP_ID=localhost
PASSKEY_ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

EMAIL_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_WEBHOOK_PUBLIC_KEY=
SENDGRID_FROM_EMAIL=integration@example.com
SENDGRID_FROM_NAME=Astral

SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

CAPTCHA_ENABLED=false
CAPTCHA_PRIMARY_PROVIDER=none
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

VOICE_ENABLED=true
LIVEKIT_AUTO_CREATE_DUMMY_DATA=true
LIVEKIT_API_KEY=<set-me>
LIVEKIT_API_SECRET=<set-me>
LIVEKIT_WEBHOOK_URL=http://api:8080/webhooks/livekit
LIVEKIT_URL=ws://livekit:7880

SEARCH_ENABLED=true
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_API_KEY=<set-me>

STRIPE_ENABLED=true

CLOUDFLARE_PURGE_ENABLED=false
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

CLAMAV_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

ADMIN_OAUTH2_CLIENT_ID=
ADMIN_OAUTH2_CLIENT_SECRET=
ADMIN_OAUTH2_AUTO_CREATE=false

YOUTUBE_API_KEY=
AUTO_JOIN_INVITE_CODE=
ASTRAL_VISIONARIES_GUILD_ID=
ASTRAL_OPERATORS_GUILD_ID=

GEOIP_HOST=geoip
GEOIP_PROVIDER=ipinfo
