{
	"appId": "app.astral",
	"appName": "Astral",
	"webDir": "dist",
	"plugins": {
		"Keyboard": {
			"resize": "ionic",
			"resizeOnFullScreen": true
		}
	},
	"android": {
		"backgroundColor": "#000000",
		"allowMixedContent": false,
		"overScrollMode": "never",
		"webContentsDebuggingEnabled": false
	},
	"server": {
		"url": "https://astraof.com/channels/@me",
		"cleartext": false,
		"allowNavigation": [
			"astraof.com",
			"*.astraof.com",
			"asrtal.ru",
			"*.asrtal.ru"
		]
	}
}
