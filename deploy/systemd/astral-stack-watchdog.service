[Unit]
Description=Astral stack watchdog
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Astral-clean
Environment=REPO_ROOT=/opt/Astral-clean
Environment="COMPOSE_PROFILES=userver"
Environment=CHECK_INTERVAL=30
Environment=FAILURE_THRESHOLD=2
Environment=RECOVERY_COOLDOWN=120
ExecStart=/opt/Astral-clean/scripts/deploy/stack-watchdog.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
